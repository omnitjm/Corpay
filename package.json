{
  "name": "corpayone-netsuite-integration",
  "version": "1.0.0",
  "description": "Integration between CorpayOne (corpayone.dk) and NetSuite for vendor bill and payment synchronization",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --config jest.config.js",
    "lint": "eslint src/ --ext .ts",
    "migrate": "ts-node src/database/migrate.ts",
    "azure:start": "cd azure && func start",
    "azure:build": "tsc && cp azure/host.json dist/"
  },
  "keywords": [
    "corpayone",
    "netsuite",
    "integration",
    "vendor-bills",
    "accounts-payable"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/functions": "^4.6.0",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "oauth-1.0a": "^2.2.6",
    "pino": "^9.6.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "azure-functions-core-tools": "^4.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
