# CorpayOne API Configuration
CORPAYONE_API_BASE_URL=https://api.corpayone.com
CORPAYONE_CLIENT_ID=your_client_id
CORPAYONE_CLIENT_SECRET=your_client_secret
CORPAYONE_WEBHOOK_SECRET=your_webhook_secret

# NetSuite API Configuration
NETSUITE_ACCOUNT_ID=your_account_id
NETSUITE_CONSUMER_KEY=your_consumer_key
NETSUITE_CONSUMER_SECRET=your_consumer_secret
NETSUITE_TOKEN_KEY=your_token_key
NETSUITE_TOKEN_SECRET=your_token_secret
# Default subsidiary ID in NetSuite (required for multi-subsidiary accounts)
NETSUITE_SUBSIDIARY_ID=
# Default AP account ID in NetSuite for vendor bills
NETSUITE_AP_ACCOUNT_ID=
# Default bank account ID in NetSuite for vendor payments
NETSUITE_BANK_ACCOUNT_ID=

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
SYNC_LOOKBACK_HOURS=24

# Webhook Server
WEBHOOK_PORT=3000
WEBHOOK_HOST=0.0.0.0

# Database
DATABASE_PATH=./data/sync.db

# Logging
LOG_LEVEL=info
