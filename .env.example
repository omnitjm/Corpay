# ------------------------------------------------------------------
# Corpay One
# ------------------------------------------------------------------
CORPAY_BASE_URL=https://api.corpayone.com/external
CORPAY_TEAM_ID=

# Auth: either a ready Bearer JWT (wins if set) ...
CORPAY_TOKEN=

# ... or a refresh-token grant against {CORPAY_IDENTITY_URL}/connect/token
CORPAY_IDENTITY_URL=https://identity.corpayone.com
CORPAY_CLIENT_ID=
CORPAY_CLIENT_SECRET=
CORPAY_REFRESH_TOKEN=

# States to sync (comma separated). Default shown.
CORPAY_SYNC_STATES=Booked,Initialized,Paid

# Only sync expenses whose paymentDate/referenceDate is within the last N days.
# The Corpay list endpoint has no date filter, so this is applied client-side to
# bound runtime as history grows. Default 90; set 0 for unlimited (all history).
CORPAY_LOOKBACK_DAYS=90

# Auto-match unstamped Corpay vendors against NetSuite by CVR/VAT number, then by
# exact company name, and stamp the match back onto the Corpay vendor. Default on;
# set to false to require manual externalId stamping of every vendor.
CORPAY_VENDOR_AUTOMATCH=true

# When auto-match finds NO candidate at all, CREATE the vendor in NetSuite
# (name/CVR/email/subsidiary, idempotent via externalId corpay-vendor-{id}) so a
# booked Corpay document always posts. Ambiguous name matches never create.
# Default on; set to false to skip such documents instead. See docs/MAPPING.md.
CORPAY_VENDOR_AUTOCREATE=true

# ------------------------------------------------------------------
# NetSuite (OAuth 1.0a Token-Based Authentication)
# ------------------------------------------------------------------
NS_ACCOUNT_ID=1234567_SB1
NS_CONSUMER_KEY=
NS_CONSUMER_SECRET=
NS_TOKEN_ID=
NS_TOKEN_SECRET=

# Posting defaults
NS_SUBSIDIARY_ID=10
NS_AP_ACCOUNT_ID=114
NS_BANK_ACCOUNT_ID=340
NS_DEFAULT_EXPENSE_ACCOUNT_ID=
NS_DEFAULT_TAX_CODE_ID=18

# Optional per-currency bank account overrides: NS_BANK_ACCOUNT_ID_<CURRENCY>
NS_BANK_ACCOUNT_ID_EUR=341

# NetSuite currency internal ids per ISO code: NS_CURRENCY_ID_<CURRENCY>.
# When the expense currency is mapped here, bills and payments post explicitly in
# that currency (and may use the matching bank override). Unmapped currencies fall
# back to the vendor's default currency AND the default bank account.
NS_CURRENCY_ID_DKK=1
NS_CURRENCY_ID_EUR=4

# Optional tax code override per currency: NS_TAX_CODE_ID_<CURRENCY>.
# Corpay carries no tax data, so currency is the only proxy — e.g. point EUR at the
# EU reverse-charge services code (149) instead of Danish 25% VAT.
# NS_TAX_CODE_ID_EUR=149
